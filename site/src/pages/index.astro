---
import { getCollection } from 'astro:content'
import NoteRow from '../components/NoteRow.astro'
import QuestionCard from '../components/QuestionCard.astro'
import Base from '../layouts/Base.astro'
import { APP_URL, byDate } from '../site'

const notes = byDate(await getCollection('notes'))
const open = byDate(await getCollection('questions')).filter((q) => q.data.status === 'open')
---

<Base>
  <section class="hero">
    <p class="kicker">The programme</p>
    <h1 class="display">What's new,<br /><span class="gold">what's next</span></h1>
    <p class="lead">
      Release notes for the app, and the questions the crew is deciding together. Read up, then have your say.
    </p>
    <a class="button" href={APP_URL}>Open the app</a>
  </section>

  {
    open.length > 0 && (
      <section>
        <div class="section-head">
          <h2 class="display">Open questions</h2>
          <a href="/questions/">All questions</a>
        </div>
        <div class="cards">
          {open.map((q) => (
            <QuestionCard entry={q} />
          ))}
        </div>
      </section>
    )
  }

  <section>
    <div class="section-head">
      <h2 class="display">Release notes</h2>
      <a href="/notes/">All notes</a>
    </div>
    <ol class="notes">
      {notes.slice(0, 4).map((n) => <NoteRow entry={n} />)}
    </ol>
  </section>
</Base>

<style>
  .hero {
    padding: 36px 0 8px;
  }
  .hero h1 {
    margin-top: 14px;
    font-size: clamp(56px, 15vw, 104px);
  }
  .hero .button {
    margin-top: 28px;
  }
  .cards {
    display: grid;
    gap: 14px;
  }
  .notes {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
